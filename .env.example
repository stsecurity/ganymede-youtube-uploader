APP_BASE_URL=
APP_WEBHOOK_SECRET=
UI_SESSION_SECRET=
UI_ENV_FILE=.env
DATABASE_URL=sqlite:////data/uploader.sqlite

GANYMEDE_BASE_URL=http://ganymede:4000
GANYMEDE_API_KEY=
GANYMEDE_VIDEOS_MOUNT=/ganymede/videos
GANYMEDE_VIDEOS_ROOT_IN_GANYMEDE=/data/videos

YOUTUBE_CLIENT_SECRET_FILE=/data/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=/data/youtube_token.json
YOUTUBE_TITLE_OPTION=1
YOUTUBE_DESCRIPTION=Uploaded from a completed Ganymede archive.
YOUTUBE_TAGS_OPTION=none
YOUTUBE_TAGS=
YOUTUBE_DEFAULT_PRIVACY=private
YOUTUBE_FINAL_PRIVACY=
YOUTUBE_CATEGORY_ID=20
YOUTUBE_NOTIFY_SUBSCRIBERS=false
DELETE_GANYMEDE_VOD_AFTER_YOUTUBE_UPLOAD=false

UPLOAD_CHUNK_SIZE_MB=8
YOUTUBE_VERIFY_TIMEOUT_MINUTES=360
YOUTUBE_VERIFY_INTERVAL_SECONDS=300

DURATION_TOLERANCE_SECONDS=30
REQUIRE_AUDIO_STREAM=false

TRACKED_TWITCH_CHANNEL=
LINKED_YOUTUBE_CHANNEL=
WEBHOOK_NOTIFICATIONS_ENABLED=false
WEBHOOK_NOTIFICATION_URL=
